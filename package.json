{
  "name": "ai-chat",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "bunx prisma generate && bunx prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "bun scripts/seed.ts",
    "stub": "bun scripts/stub-provider.ts",
    "db:test:deploy": "bun --env-file=.env.test prisma migrate deploy",
    "test": "bun test",
    "test:db": "bun run db:test:deploy && bun --env-file=.env.test test tests/",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/client": "^6.0.0",
    "argon2": "^0.45.1",
    "dotenv": "^17.4.2",
    "isomorphic-dompurify": "^4.1.0",
    "markdown-it": "^15.0.1",
    "next": "16.3.3",
    "prisma": "^6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun": "latest",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
